{
  "opencollection": "1.0.0",
  "info": {
    "name": "systemd-hostnamed (org.freedesktop.hostname1) Boot Users API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Logged-In Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "dbus://system/org.freedesktop.hostname1/users"
          },
          "docs": "Mirrors `ListUsers()`."
        },
        {
          "info": {
            "name": "Get A User By UID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "dbus://system/org.freedesktop.hostname1/users/:uid",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Mirrors `GetUser(uid)`."
        },
        {
          "info": {
            "name": "Terminate A User's Sessions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "dbus://system/org.freedesktop.hostname1/users/:uid/terminate",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Mirrors `TerminateUser(uid)`."
        }
      ]
    }
  ],
  "bundled": true
}
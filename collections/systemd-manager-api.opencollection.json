{
  "opencollection": "1.0.0",
  "info": {
    "name": "systemd-hostnamed (org.freedesktop.hostname1) Boot Manager API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Manager",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Reload networkd Configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "dbus://system/org.freedesktop.hostname1/manager/reload"
          },
          "docs": "Mirrors `Reload()` on Manager."
        },
        {
          "info": {
            "name": "Get Full networkd State Description",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "dbus://system/org.freedesktop.hostname1/manager/describe"
          },
          "docs": "Mirrors `Describe()`. Returns a JSON dump of full networkd state."
        },
        {
          "info": {
            "name": "Reexecute The Manager",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "dbus://system/org.freedesktop.hostname1/manager/reexecute"
          },
          "docs": "Re-executes the systemd binary in-place, preserving state. Mirrors `Reexecute()`."
        },
        {
          "info": {
            "name": "Enable Unit Files",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "dbus://system/org.freedesktop.hostname1/manager/enable",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates the symlinks that make units start at boot. Mirrors `EnableUnitFiles(files, runtime, force)`."
        },
        {
          "info": {
            "name": "Disable Unit Files",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "dbus://system/org.freedesktop.hostname1/manager/disable",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Removes the symlinks that make units start at boot. Mirrors `DisableUnitFiles(files, runtime)`."
        },
        {
          "info": {
            "name": "Mask Unit Files",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "dbus://system/org.freedesktop.hostname1/manager/mask",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Symlinks units to /dev/null so they cannot be started. Mirrors `MaskUnitFiles(files, runtime, force)`."
        },
        {
          "info": {
            "name": "Unmask Unit Files",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "dbus://system/org.freedesktop.hostname1/manager/unmask"
          },
          "docs": "Reverses MaskUnitFiles. Mirrors `UnmaskUnitFiles(files, runtime)`."
        },
        {
          "info": {
            "name": "Set The Default Boot Target",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "dbus://system/org.freedesktop.hostname1/manager/set-default-target",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Mirrors `SetDefaultTarget(target, force)`."
        },
        {
          "info": {
            "name": "Get The Default Boot Target",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "dbus://system/org.freedesktop.hostname1/manager/default-target"
          },
          "docs": "Mirrors `GetDefaultTarget()`."
        },
        {
          "info": {
            "name": "Get Manager Properties",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "dbus://system/org.freedesktop.hostname1/manager/snapshot"
          },
          "docs": "Returns the full property map of the Manager (Version, Features, Virtualization, Architecture, Tainted, FirmwareTimestamp, etc.)."
        },
        {
          "info": {
            "name": "Describe Manager State",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "dbus://system/org.freedesktop.hostname1/io.systemd.Manager/Describe"
          },
          "docs": "Calls `io.systemd.Manager.Describe` on PID 1's varlink socket. Returns the manager's runtime state (architecture, virtualization, version, features, tainted, timestamps)."
        },
        {
          "info": {
            "name": "List All Units",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "dbus://system/org.freedesktop.hostname1/io.systemd.Manager/ListUnits"
          },
          "docs": "Calls `io.systemd.Manager.ListUnits`. Returns an iterable stream of unit records."
        }
      ]
    }
  ],
  "bundled": true
}